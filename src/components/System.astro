---
import { locales, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { content } = locales[locale];
const s = content.system;
---

<section class="system section" id="process" aria-labelledby="system-heading" data-system>
  <div class="shell">
    <header class="system__head">
      <h2 id="system-heading">{s.heading}</h2>
    </header>

    <div class="system__scene" data-system-scene>
      {/* Direction-aware green Stroke progress line (fills across the pin). */}
      <div class="system__rail">
        <span class="system__line" aria-hidden="true">
          <span class="system__line-fill" data-system-fill></span>
        </span>
        <ol class="system__ticks">
          {s.steps.map((step, i) => (
            <li class="system__tick" data-tick style={`--i:${i}`}>
              <span class="system__num mono">{step.n}</span>
              <span class="system__label mono">{step.label}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="system__bodies">
        {s.steps.map((step, i) => (
          <p class="system__body" data-body style={`--i:${i}`}>{step.body}</p>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .system__head {
    max-inline-size: var(--measure);
    margin-block-end: var(--space-2xl);
  }

  .system__rail {
    position: relative;
    margin-block-end: var(--space-xl);
  }
  .system__line {
    position: absolute;
    inset-block-start: 1.25rem;
    inset-inline: 0;
    block-size: var(--stroke-h);
    background-color: var(--hairline);
  }
  .system__line-fill {
    display: block;
    block-size: 100%;
    inline-size: 100%;
    background-color: var(--accent);
    transform: scaleX(var(--fill, 0)); /* motion scrubs --fill 0 -> 1 */
    transform-origin: inline-start; /* RTL start = right (direction-aware) */
  }

  .system__ticks {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }
  .system__tick {
    display: grid;
    gap: 0.5rem;
    padding-block-start: 2.75rem;
    /* Inactive steps dim; motion sets the active one to full + green label. */
    opacity: 0.4;
    transition: opacity var(--dur) var(--ease);
  }
  .system__tick[data-active="true"] {
    opacity: 1;
  }
  .system__num {
    position: absolute;
    inset-block-start: 0;
    color: var(--text-3);
    font-size: var(--fs-mono);
  }
  .system__tick[data-active="true"] .system__num {
    color: var(--accent);
  }
  .system__label {
    color: var(--text);
    font-size: var(--fs-mono);
  }
  .system__tick[data-active="true"] .system__label {
    color: var(--accent);
  }

  .system__bodies {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }
  .system__body {
    color: var(--text-2);
    opacity: 0.5;
    transition: opacity var(--dur) var(--ease);
  }
  .system__body[data-active="true"] {
    opacity: 1;
    color: var(--text);
  }

  /* Reduced motion / no-JS: full unpinned static list (all steps legible). */
  @media (prefers-reduced-motion: reduce) {
    .system__tick,
    .system__body {
      opacity: 1;
    }
    .system__line-fill {
      transform: scaleX(1);
    }
  }

  @media (max-width: 60rem) {
    .system__line {
      display: none;
    }
    .system__ticks,
    .system__bodies {
      grid-template-columns: 1fr;
    }
    .system__ticks {
      gap: var(--space-lg);
    }
    .system__tick {
      grid-template-columns: auto 1fr;
      align-items: baseline;
      gap: 0.75rem;
      padding-block-start: 0;
    }
    .system__num {
      position: static;
    }
    /* On mobile, pair each body under its tick by source order via a flow list. */
    .system__bodies {
      margin-block-start: var(--space-lg);
      gap: var(--space-lg);
    }
  }
</style>

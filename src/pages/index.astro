---
// Root: route visitors into a locale tree. No-JS falls back to the meta refresh
// (and the noscript links); JS prefers a stored choice, then navigator.language.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>YASIR_ — Independent design & web studio</title>
    <link rel="canonical" href="/en/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="ar" href="/ar/" />
    <link rel="alternate" hreflang="x-default" href="/en/" />
    <meta http-equiv="refresh" content="0; url=/en/" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("locale");
          var lang = stored || (navigator.language || "en").slice(0, 2).toLowerCase();
          location.replace(lang === "ar" ? "/ar/" : "/en/");
        } catch (e) {
          location.replace("/en/");
        }
      })();
    </script>
  </head>
  <body>
    <noscript>
      <a href="/en/">Continue to YASIR_</a> · <a href="/ar/">المتابعة بالعربية</a>
    </noscript>
  </body>
</html>
